# Dockerfile for Nakamoto PoC dag-l0 node
# Pre-requisite: sbt dagL0/stage (creates modules/dag-l0/target/universal/stage/)

FROM eclipse-temurin:21-jre-alpine

RUN apk add --no-cache bash libstdc++

WORKDIR /opt/app

# Copy staged application (jars + launcher script)
COPY modules/dag-l0/target/universal/stage/ /opt/app/

# Make the launcher executable
RUN chmod +x /opt/app/bin/tessellation-dag-l0

ENTRYPOINT ["/opt/app/bin/tessellation-dag-l0"]
