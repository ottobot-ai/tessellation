# Dockerfile for dag-l1 node (standard BFT consensus)
# Pre-requisite: sbt dagL1/stage

FROM eclipse-temurin:21-jre-alpine

RUN apk add --no-cache bash libstdc++ curl

WORKDIR /opt/app

# Copy staged application (jars + launcher script)
COPY modules/dag-l1/target/universal/stage/ /opt/app/

# Make the launcher executable
RUN chmod +x /opt/app/bin/tessellation-dag-l1

ENTRYPOINT ["/opt/app/bin/tessellation-dag-l1"]
