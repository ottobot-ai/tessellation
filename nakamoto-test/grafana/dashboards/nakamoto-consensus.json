{
  "dashboard": null,
  "uid": "nakamoto-consensus",
  "title": "Nakamoto Consensus",
  "tags": ["tessellation", "nakamoto"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Chain Overview",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "max(dag_nakamoto_ordinal)", "legendFormat": "Best Ordinal" }],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}] } } }
    },
    {
      "id": 2,
      "title": "Finalized Ordinal",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "max(dag_nakamoto_finalized_ordinal)", "legendFormat": "Finalized" }],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{"color": "blue", "value": null}] } } }
    },
    {
      "id": 3,
      "title": "Current Slot",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "max(dag_nakamoto_slot)", "legendFormat": "Slot" }],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{"color": "purple", "value": null}] } } }
    },
    {
      "id": 4,
      "title": "Fill Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "max(dag_nakamoto_fill_rate) * 100", "legendFormat": "Fill %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 5}, {"color": "green", "value": 10}] } } }
    },
    {
      "id": 5,
      "title": "Snapshots per Minute (all nodes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sum(rate(dag_nakamoto_snapshots_produced_total[1m])) * 60", "legendFormat": "Produced/min" },
        { "expr": "sum(rate(dag_nakamoto_snapshots_received_total[1m])) * 60", "legendFormat": "Received/min (gossip)" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 6,
      "title": "Ordinal Progression",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "dag_nakamoto_ordinal", "legendFormat": "{{instance}} tip" },
        { "expr": "dag_nakamoto_finalized_ordinal", "legendFormat": "{{instance}} finalized" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 0 } } }
    },
    {
      "id": 7,
      "title": "Fork Count",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 12 },
      "targets": [
        { "expr": "dag_nakamoto_fork_count", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 5 }, "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 3}, {"color": "red", "value": 5}] } } }
    },
    {
      "id": 8,
      "title": "Slots Won / Rejected",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 12 },
      "targets": [
        { "expr": "rate(dag_nakamoto_slots_won_total[1m]) * 60", "legendFormat": "{{instance}} won/min" },
        { "expr": "rate(dag_nakamoto_snapshots_rejected_total[1m]) * 60", "legendFormat": "{{instance}} rejected/min" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 9,
      "title": "Attestation Weight",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 12 },
      "targets": [
        { "expr": "dag_nakamoto_attestation_weight", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10 }, "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.67}] } } }
    },
    {
      "id": 10,
      "title": "Slot Gap Distribution (avg)",
      "description": "Average number of empty slots between consecutive snapshots",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 18 },
      "targets": [{ "expr": "avg(dag_nakamoto_slot_gap_sum / dag_nakamoto_slot_gap_count)", "legendFormat": "Avg slot gap" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 20}] } } }
    },
    {
      "id": 11,
      "title": "Max Slot Gap",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 18 },
      "targets": [{ "expr": "max(dag_nakamoto_slot_gap_max)", "legendFormat": "Max gap" }],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 30}, {"color": "red", "value": 100}] } } }
    },
    {
      "id": 20,
      "title": "─── DAG-L1 Transaction Layer ───",
      "type": "text",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 22 },
      "options": { "mode": "markdown", "content": "## DAG-L1 Transactions" }
    },
    {
      "id": 12,
      "title": "L1 Transactions per Second (TPS)",
      "description": "Rate of DAG transactions received by L1 nodes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "sum(rate(dag_http_client_request_count_total{route=\"dag_l1_output\",status=\"200\"}[1m]))", "legendFormat": "L1→GL0 blocks/s" },
        { "expr": "sum(rate(dag_rumors_consumed_total{content_type_short=\"Signed[Block]\",outcome=\"success\"}[1m]))", "legendFormat": "L1 blocks consumed/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2, "custom": { "drawStyle": "line", "fillOpacity": 15 } } }
    },
    {
      "id": 13,
      "title": "L1 Blocks Total",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "dag_rumors_consumed_total{content_type_short=\"Signed[Block]\",outcome=\"success\"}", "legendFormat": "{{instance}} blocks" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 5 } } }
    },
    {
      "id": 14,
      "title": "Chain Length",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 18 },
      "targets": [{ "expr": "max(dag_nakamoto_chain_length)", "legendFormat": "Length" }],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}] } } }
    },
    {
      "id": 15,
      "title": "Finalized Total",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 18 },
      "targets": [{ "expr": "max(dag_nakamoto_finalized_total)", "legendFormat": "Finalized" }],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{"color": "blue", "value": null}] } } }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
