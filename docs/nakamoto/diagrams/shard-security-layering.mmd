flowchart TB
    CP["Shard checkpoint<br/>root claims plus complete replay inputs"]
    CP --> AUTH["verify signatures, registered VRF keys,<br/>KES, committee membership, duty, and ancestry"]
    AUTH --> REPLAY["every GL0 adopter recreates every CL1 transition<br/>at the signed finalized execution base"]
    REPLAY --> MATCH{"all recreated roots match?"}
    MATCH -->|yes| USE["eligible for store, attest, selection,<br/>embedding, and canonical use"]
    MATCH -->|no| DROP["reject before value is usable"]
    DROP -.-> EVIDENCE["self-contained fraud or equivocation evidence"]
    EVIDENCE --> SLASH["deterministic slash folded into canonical GL0 state"]
    WATCH["Watchtowers re-execute independently"] -.-> EVIDENCE
    NOTE["Quorum and depth select among replay-valid checkpoints.<br/>They are not validity gates."]
    USE -.-> NOTE
