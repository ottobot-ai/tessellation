    classDef v2 fill:#e8e0ff,stroke:#6c3483,color:#4a235a;
    classDef warn fill:#ffe9cc,stroke:#b9770e,color:#7e5109;
    classDef alt fill:#e0f7e0,stroke:#27ae60,color:#145a32;
    class T1,T2 v1;
    class DA,AP,DIS v2;
    class NOTE1 warn;
    class ALT alt;
