flowchart TB
    B["ML0 signed state-channel binaries"]
    B --> ADM
    subgraph ADMISSION["GL0 BINARY ADMISSION COMMITTEE"]
        ADM["per-binary secret VRF draw<br/>authenticate and buffer"]
    end
    ADM --> EXEC
    subgraph COMMITTEE["GL0 EXECUTION COMMITTEE"]
        EXEC["chain-link window<br/>pin finalized execution base"]
        REPLAY["recreate every included CL1 transition"]
        BUILD["claim per-metagraph roots<br/>carry all replay inputs"]
        SIGN["validate, recreate, then sign"]
        EXEC --> REPLAY --> BUILD --> SIGN
    end
    SIGN --> VERIFY
    subgraph GLOBAL["EVERY GL0 ADOPTER"]
        VERIFY["verify identity, keys, KES, duty,<br/>assignment, ancestry, and schema"]
        AGAIN["recreate every CL1 transition<br/>at signed finalized base"]
        COMPARE{"local roots equal claims?"}
        EMBED["store, attest, select, and embed"]
        VERIFY --> AGAIN --> COMPARE
        COMPARE -->|yes| EMBED
        COMPARE -->|no| REJECT["reject; optional fraud evidence"]
    end
    EMBED --> RETURN["finalized GL0 state returns downstream"]
