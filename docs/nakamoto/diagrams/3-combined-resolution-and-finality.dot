// Checkpoint inclusion and inherited GL0 finality.
// Render: dot -Tpng -Gdpi=150 3-combined-resolution-and-finality.dot -o 3-combined-resolution-and-finality.png

digraph combined {
  rankdir=TB;
  ranksep=0.8;
  nodesep=0.5;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];

  ml0 [label="ML0 signed state-channel binary", fillcolor="#E3F2FD", color="#1565C0"];
  admission [label="GL0 binary admission committee", fillcolor="#FFF3CD", color="#E67E00"];
  checkpoint [label="Execution-shard checkpoint\nroot claims + complete replay inputs", fillcolor="#E8E0FF", color="#6A3D9A", penwidth=2];
  replay [label="Every GL0 adopter verifies identities and keys,\nthen recreates every CL1 transition", fillcolor="#D4EDDA", color="#1A7F37", penwidth=2];
  global [label="Canonical GL0 snapshot\ncheckpoint inherits this ordinal's finality", fillcolor="#D7E9FC", color="#0B5394", penwidth=2];
  downstream [label="Finalized GL0 state returns to\nGL1, ML0, CL1, and DL1", fillcolor="#FFFFFF", color="#555555"];

  ml0 -> admission -> checkpoint -> replay -> global -> downstream;

  quorum [shape=note, label="Committee quorum and shard depth\nselect only among replay-valid checkpoints.", fillcolor="#FFFFFF", color="#888888"];
  watchtower [shape=octagon, label="Watchtower\ndefense-in-depth replay", fillcolor="#FFF3CD", color="#E67E00"];
  slash [label="Self-contained fraud evidence\ncanonical deterministic slash", fillcolor="#F8D7DA", color="#721C24"];

  replay -> quorum [style=dashed];
  watchtower -> slash [style=dashed];
  checkpoint -> watchtower [style=dashed];
}
