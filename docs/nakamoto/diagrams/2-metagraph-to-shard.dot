// TARGET DESIGN: metagraph binaries sharing one execution shard.
// Render: dot -Tpng -Gdpi=150 2-metagraph-to-shard.dot -o 2-metagraph-to-shard.png

digraph metagraph_to_shard {
  label="TARGET DESIGN: metagraph binaries to one execution shard";
  labelloc=t;
  fontsize=15;
  rankdir=TB;
  ranksep=0.75;
  nodesep=0.45;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];

  cl1a [label="CL1 economics A", fillcolor="#E3F2FD", color="#1565C0"];
  dl1a [label="DL1 custom data A", fillcolor="#FCE4EC", color="#AD1457"];
  ml0a [label="ML0 A\nsigned state-channel binary", fillcolor="#FFFFFF", color="#555555"];
  cl1b [label="CL1 economics B", fillcolor="#E3F2FD", color="#1565C0"];
  dl1b [label="DL1 custom data B", fillcolor="#FCE4EC", color="#AD1457"];
  ml0b [label="ML0 B\nsigned state-channel binary", fillcolor="#FFFFFF", color="#555555"];

  cl1a -> ml0a;
  dl1a -> ml0a;
  cl1b -> ml0b;
  dl1b -> ml0b;

  admission [label="GL0 per-binary admission\nsecret VRF; authenticate and buffer", fillcolor="#FFF3CD", color="#E67E00"];
  ml0a -> admission;
  ml0b -> admission;

  checkpoint [label="One shard checkpoint\nexact ordered inputs + scoped per-MG diff\n+ complete root + exact Phase-2 base/pre-root", fillcolor="#E8E0FF", color="#6A3D9A", penwidth=2];
  admission -> checkpoint [label="static hash(address) mod numShards"];

  replay [label="Producer and every execution signer\nindependently replay exact inputs;\nsign only identical diff + root", fillcolor="#D4EDDA", color="#1A7F37", penwidth=2];
  threshold [label="Distinct execution threshold", fillcolor="#FFF3CD", color="#E67E00", penwidth=2];
  adopt [label="Ordinary noncommittee GL0 verifies exact base/pre-root CAS,\ncontinuity, assignment, namespace, and threshold;\napplies scoped diff and recomputes root", fillcolor="#D7E9FC", color="#0B5394", penwidth=2];
  checkpoint -> replay -> threshold -> adopt;

  watchtower [shape=octagon, label="Selected noncommittee watchtowers\nindependently replay; release and\nadjudication timing remains open", fillcolor="#FFF3CD", color="#E67E00"];
  checkpoint -> watchtower [style=dashed];

  note [shape=note, label="ML0 operators produce binaries.\nAdmission and execution committees are GL0 operators.\nCustom DL1 bytes are isolated commitment/DA payload,\nnot framework-economic authority.", fillcolor="#FFFFFF", color="#888888"];
  adopt -> note [style=invis];
}
