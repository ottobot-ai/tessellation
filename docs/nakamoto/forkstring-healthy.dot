digraph H {
  graph [splines=line, fontname="Helvetica"];
  node  [fontname="Helvetica", fontsize=11];
  edge  [arrowsize=0.6, penwidth=1.6, color="#2e7d32"];
  labelloc="t"; fontsize=15;
  label="HEALTHY  —  characteristic string w = 0 0 0 0 0  (every slot uniquely honest, one tine)";

  // genesis + single honest tine; node = block at (slot x, depth y); filled = honest-unique
  g  [pos="0,0!",   shape=square, style=filled, fillcolor="#9e9e9e", label="g\nd0"];
  v1 [pos="1.4,0!", shape=circle, style=filled, fillcolor="#2e7d32", fontcolor=white, label="d1"];
  v2 [pos="2.8,0!", shape=circle, style=filled, fillcolor="#2e7d32", fontcolor=white, label="d2"];
  v3 [pos="4.2,0!", shape=circle, style=filled, fillcolor="#1565c0", fontcolor=white, label="d3\nFINAL"];
  v4 [pos="5.6,0!", shape=circle, style=filled, fillcolor="#2e7d32", fontcolor=white, label="d4"];
  v5 [pos="7.0,0!", shape=circle, style=filled, fillcolor="#6a1b9a", fontcolor=white, label="d5\ntip"];
  g->v1->v2->v3->v4->v5;

  // characteristic string row
  w0 [pos="0,-1.1!",   shape=plaintext, label="w:"];
  w1 [pos="1.4,-1.1!", shape=plaintext, label="0"];
  w2 [pos="2.8,-1.1!", shape=plaintext, label="0"];
  w3 [pos="4.2,-1.1!", shape=plaintext, label="0"];
  w4 [pos="5.6,-1.1!", shape=plaintext, label="0"];
  w5 [pos="7.0,-1.1!", shape=plaintext, label="0"];
  note [pos="3.5,-1.9!", shape=plaintext, fontsize=10, fontcolor="#1565c0",
        label="single tine · gl0 FINAL (blue) trails tip (purple) on the SAME tine · longest-tine = finalized lineage"];
}
