// 3-phase snapshot progression with triggers and GKL-property mapping
//
// Render: dot -Tpng phase-state-machine.dot -o phase-state-machine.png
//
// Phase belongs to an exact (ordinal, hash), not to an ordinal alone. A P2 hash
// may be orphaned and replaced by density selection. Multiple independent
// triggers can qualify P2; phases gate distinct system affordances. There is no
// later protocol phase or depth-based fork-choice floor.
//
// Research mapping: GKL "Bitcoin Backbone Protocol" (2015) — Chain Growth,
// Chain Quality, Common Prefix properties. Whether those bounds transfer to the
// actual Taktikos/LDD plus Avalanche construction is an explicit proof obligation;
// the labels below are intended intuition, not a proven theorem.
//
// Target contract: docs/review/CONSENSUS-ARTIFACT-LIFECYCLE.md section 4.
// Current implementation is split across FinalityGate, FinalityTrigger,
// SnapshotLeaderLoop, SettledOrdinalTracker, chain selection, and MPT overlay.

digraph phase_state_machine {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=11, labelloc=t, ranksep=1.1, nodesep=0.75, pad=0.2,
         label="Snapshot phase progression  —  intended GKL-property mapping (proof pending)\n(triggers on edges; affordances unlocked listed under each state)"];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9];

  // --- Phase 0: PENDING ----------
  P0 [label="Phase 0 — PENDING\n\nIntended property: CHAIN GROWTH\n(chain must extend, rivals expected)\n\nAffordances:\n• Overlay branch (ChangeSet)\n• Local writes during accept()\n• Gossip publish allowed\n• No follower read\n• No SC binary confirm",
      fillcolor="#e3f2fd"];

  // --- Phase 1: PROVISIONAL ----------
  P1 [label="Phase 1 — PROVISIONAL\n\nIntended property: CHAIN QUALITY (contested)\n(attestations accumulating;\n adversary composition bound pending proof)\n\nAffordances:\n• On canonical bestTip chain\n• Counted in chain-selection\n• Attestation weight recording\n• Still no follower read",
      fillcolor="#fff9c4"];

  // --- Phase 2: OPERATIONAL ----------
  P2 [label="Phase 2 — OPERATIONAL\n\nOptimistic/depth confidence boundary\n(low-probability density reorg remains possible)\n\nAffordances:\n• Exact-hash followers consume\n• Metagraph globalSyncView allowed\n• Shard execution base allowed\n• Cross-MG origin allowed\n• Reversible confirmations issue",
      fillcolor="#c8e6c9"];

  // A density reorg changes canonical identity. The previously operational
  // exact hash is orphaned; it does not regress to a phase on the new branch.
  ORPHANED [label="ORPHANED EXACT HASH\n\nOld (ordinal, hash) is no longer canonical\n• P2 affordances are revoked\n• Followers receive rollback/re-follow\n• Never treated as the replacement artifact",
            fillcolor="#ffcdd2", color="#b71c1c"];

  REPLACEMENT [shape=note, label="Replacement branch is a different exact hash\nand independently progresses P0 -> P1 -> P2",
               fillcolor="#e3f2fd", color="#1565c0"];

  RECOVERY [shape=octagon, label="RecoveryRequired — NOT A PHASE\n\nObjective comparison needs history older than retained state\n• stop production and mutation\n• fetch exact authenticated history/state\n• resume only after verified reconstruction\n• operator cannot choose the winning branch\n\nk2 = 100*k1 is recommended local retention/proof/rollback capacity only",
            fillcolor="#ffcdd2", color="#b71c1c"];

  // --- Transition edges with trigger labels ----------
  P0 -> P1 [label="  maxvalid-tk\n  canonical tine  "];

  P1 -> P2 [label="  decided-attestation T_weight\n  OR T_depth1 (canonical k1 depth)  "];

  // --- The "always pending until promoted" self-loop ----------
  P0 -> P0 [label="  awaiting parent / rivals  ",
            style=dashed, color="#666666"];

  // --- The "rollback path" — formally allowed P1 → P0 ----------
  P1:s -> P0:s [label="  shallow reorg  ",
                 style=dashed, color="#d32f2f", constraint=false];

  // P2 hash replacement is the intended epsilon-event recovery path. The old
  // hash becomes orphaned; a separate artifact follows the normal progression.
  P2:n -> ORPHANED:w [label="  maxvalid-bg selects a\n  replacement exact hash  ",
                      style=dashed, color="#d32f2f", constraint=false];
  ORPHANED -> REPLACEMENT [label="  separate artifact  ", style=dotted,
                           arrowhead=none, color="#666666", constraint=false];

  // Retention exhaustion does not decide the fork. The node halts mutation,
  // reconstructs exact authenticated history, and resumes ordinary comparison.
  P2:s -> RECOVERY:n [label="  required comparison history\n  unavailable locally  ",
                      style=dashed, color="#b71c1c", constraint=false];
  RECOVERY -> P2 [label="  verified reconstruction;\n  ordinary valid-chain comparison resumes  ",
                  style=dashed, color="#1565c0", constraint=false];
}
