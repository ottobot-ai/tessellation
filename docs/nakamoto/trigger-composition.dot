// Target GL0 finality trigger composition.
// Render: dot -Tpng trigger-composition.dot -o trigger-composition.png
//
// This is a Nakamoto/Taktikos phase gadget. It is not a BFT vote/lock/QC
// protocol. Phase belongs to an exact hash-bound snapshot reference.

digraph trigger_composition {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=11, labelloc=t, ranksep=0.9, nodesep=0.55, pad=0.2,
         label="GL0 Phase-2 trigger composition\nAvalanche/Snowball is the optimistic rail; k1 depth is the fallback; Phase 2 remains density-reorgable"];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge [fontname="Helvetica", fontsize=9];

  executed [label="Locally executed canonical candidate\n(ref = ordinal + hash + parent + root)", fillcolor="#e3f2fd"];
  registry [label="Canonical sample/weight registry\n(anchor/schema engineering gate)", fillcolor="#e3f2fd"];
  replies [label="Authenticated peer preferences\nfresh and branch-bound", fillcolor="#e3f2fd"];
  tip [label="maxvalid-tk canonical tine\nand exact depth", fillcolor="#e3f2fd"];

  snowball [label="Snowball cascade\nuniform K sample\nalpha support\nper-color confidence\nbeta margin", fillcolor="#fff9c4"];
  emit [label="Emit once\nattestation for locally\nexecuted exact hash", fillcolor="#fff9c4"];
  weight [label="T_weight over decided\nattestations for the same exact hash", fillcolor="#fff9c4"];
  optimistic [label="T_optimistic(hash) :=\ndecided-attestation T_weight", fillcolor="#dcedc8"];
  depth1 [label="T_depth1(hash)\ncanonical hash is k1 deep", fillcolor="#dcedc8"];
  gate2 [label="OR\nfirst qualifying rail", shape=diamond, fillcolor="#c8e6c9"];
  phase2 [label="Phase 2: OPERATIONAL\nexact-hash downstream use\ndensity rollback retained", fillcolor="#a5d6a7", penwidth=2];

  density [label="maxvalid-bg density comparison\nover valid reconstructed history", fillcolor="#ffcdd2"];
  reorg [label="Phase2Reorg\nold hash orphaned\nrollback and re-follow", fillcolor="#ffcdd2"];

  retention [label="k2 = 100*k1 recommendation\nlocal retention / proof service / rollback capacity\nnever a finality or fork-choice floor", fillcolor="#d1c4e9"];
  unavailable [label="Required objective comparison\nhistory unavailable locally?", shape=diamond, fillcolor="#ffcdd2"];
  recovery [label="RecoveryRequired (not a phase)\nstop production and mutation\nfetch exact authenticated history/state\nno operator-selected winner", fillcolor="#ffcdd2", color="#b71c1c"];

  executed -> snowball;
  replies -> snowball;
  registry -> snowball;
  snowball -> emit;
  emit -> weight;
  registry -> weight;
  weight -> optimistic;
  optimistic -> gate2;
  tip -> depth1;
  depth1 -> gate2;
  gate2 -> phase2;

  tip -> density;
  phase2 -> density;
  density -> reorg [label="denser rival wins"];
  reorg -> snowball [label="replacement candidate", style=dashed, color="#c62828"];

  retention -> unavailable [label="capacity only", style=dashed];
  density -> unavailable [label="needed history absent", style=dashed, color="#b71c1c"];
  unavailable -> recovery [label="yes", color="#b71c1c"];
  recovery -> density [label="verified reconstruction;\nresume ordinary comparison", style=dashed, color="#1565c0"];
}
